ADMIN_EMAIL=admin@ugn.local
ADMIN_PASSWORD=change-this-local-password
JWT_SECRET=replace-with-at-least-32-random-characters
S3_ACCESS_KEY=ugnlocal
S3_SECRET_KEY=local-development-only-password

# Reliability settings (defaults shown)
UPLOAD_IDLE_DAYS=7
WORKER_MAX_SCRATCH_GIB=100
FRONTEND_ORIGIN=http://localhost:5173
# Storage endpoints default to local MinIO in Compose.
# Keep your existing ADMIN_PASSWORD and JWT_SECRET in .env.
